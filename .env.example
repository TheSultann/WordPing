BOT_TOKEN=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wordping
# Optional default: UTC offset if you want to override Node timezone
TZ=UTC
# Logging
LOG_LEVEL=info
# Optional: pretty | json
# LOG_FORMAT=pretty
# Backups
BACKUP_DIR=./backups/postgres
BACKUP_FILE_PREFIX=wordping-db
BACKUP_RETENTION_COUNT=14
# Optional Telegram Bot API base URL for backup delivery.
# Cloud Bot API default is 50 MB upload limit; local Bot API server can handle larger files.
# TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
# Optional explicit upload limit override in MB.
# TELEGRAM_MAX_UPLOAD_MB=50
# Optional PostgreSQL client binaries
# PG_DUMP_BIN=pg_dump
# PG_RESTORE_BIN=pg_restore

# API server
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
INIT_DATA_MAX_AGE_SECONDS=86400
# URL for Telegram Mini App (used by bot)
WEBAPP_URL=http://localhost:5173
# Allow dev auth with x-dev-user-id header (ONLY for local development)
ALLOW_DEV_AUTH=false
# Admin Telegram ID for /api/admin (default: 467595754)
# ADMIN_TELEGRAM_ID=467595754
# Add-word limit per user per day (bot /add flow)
DAILY_WORD_ADD_LIMIT=9
# Unlimited add-word IDs (comma-separated), e.g. admin IDs
# UNLIMITED_WORD_ADD_IDS=467595754
# Translation settings
# Request timeout for translation API calls (1000..30000)
TRANSLATE_API_TIMEOUT_MS=5000
TRANSLATE_CACHE_MAX=2000

# Hugging Face (primary)
HF_API_KEY=
HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_MODEL_RU_EN=Helsinki-NLP/opus-mt-ru-en
HF_MODEL_EN_RU=Helsinki-NLP/opus-mt-en-ru
HF_MODEL_UZ_EN=Helsinki-NLP/opus-mt-uz-en
HF_MODEL_EN_UZ=Helsinki-NLP/opus-mt-en-uz

# Gemini (secondary fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# MyMemory (final fallback)
TRANSLATE_API_URL=https://api.mymemory.translated.net/get

# News digest fallback (separate worker only)
NEWS_RSS_FEEDS=https://www.gazeta.uz/en/rss/,https://kun.uz/en/news/rss,https://uzdaily.uz/en/rss
NEWS_RSS_PRIMARY_DOMAINS=gazeta.uz,kun.uz,uzdaily.uz
NEWS_CACHE_TTL_DAYS=7
NEWS_RSS_TIMEOUT_MS=7000
NEWS_RSS_MAX_ITEMS_PER_FEED=80
NEWS_RSS_MATCH_MIN_SCORE=55
NEWS_RSS_TOKEN_COVERAGE_MIN=0.8
NEWS_RSS_REFRESH_CRON=0 * * * *
NEWS_ENQUEUE_CRON=0 * * * *
NEWS_RESOLVE_CRON=*/5 * * * *
NEWS_MARK_OLD_CRON=15 2 * * *
NEWS_METRICS_CRON=0 * * * *
NEWS_SOURCE_LINK_CHECK_CRON=45 * * * *
NEWS_SOURCE_LINK_CHECK_BATCH=30
NEWS_SOURCE_LINK_TIMEOUT_MS=5000
NEWS_PRUNE_CRON=20 3 * * *
NEWS_STALE_DAYS=2
# Preferred: staged retry in minutes for "news_not_found" (attempt1,attempt2,...)
NEWS_NOT_FOUND_RETRY_STEPS_MINUTES=30,120,360,720,1440
# Legacy fallback (used only if NEWS_NOT_FOUND_RETRY_STEPS_MINUTES is empty)
NEWS_NOT_FOUND_RETRY_HOURS=12
NEWS_MAX_JOB_ATTEMPTS=5
NEWS_RETRY_BASE_MINUTES=15
NEWS_RETRY_MAX_MINUTES=120
NEWS_EXHAUSTED_RETRY_HOURS=24
NEWS_JOB_RETENTION_DAYS=14
NEWSDATA_API_KEY=
NEWSDATA_API_URL=https://newsdata.io/api/1/latest
NEWS_NEWDATA_TIMEOUT_MS=7000
NEWS_NEWDATA_DAILY_LIMIT=200
NEWS_NEWDATA_DAILY_BUDGET=120
NEWS_NEWDATA_WORD_RETRY_HOURS=12
NEWS_GDELT_TIMEOUT_MS=7000
NEWS_GDELT_MAX_RECORDS=25
NEWS_GDELT_MIN_INTERVAL_SECONDS=10
NEWS_GDELT_COOLDOWN_MINUTES=30
NEWS_GDELT_WORD_RETRY_HOURS=24
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_QUERY_SCOPE=Uzbekistan
NEWS_GUARDIAN_TIMEOUT_MS=7000
NEWS_GUARDIAN_PAGE_SIZE=20
NEWS_GUARDIAN_SKIP_WITHOUT_KEY=true
GUARDIAN_API_URL=https://content.guardianapis.com/search
# Optional. For low-traffic dev/testing you can use: test
GUARDIAN_API_KEY=test

# Optional separate DB for integration tests
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/wordping_test?schema=public
