{
  "name": "wordping",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev:bot": "ts-node-dev --respawn --transpile-only src/bot/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/scheduler/worker.ts",
    "dev:news-worker": "ts-node-dev --respawn --transpile-only src/scheduler/newsWorker.ts",
    "dev:api": "ts-node-dev --respawn --transpile-only src/api/index.ts",
    "dev:web": "npm --prefix web run dev",
    "lint": "eslint src/api src/bot src/db src/i18n src/scheduler src/services src/utils scripts tests web/src prisma.config.ts vitest.config.ts web/vite.config.ts eslint.config.mjs",
    "lint:fix": "eslint src/api src/bot src/db src/i18n src/scheduler src/services src/utils scripts tests web/src prisma.config.ts vitest.config.ts web/vite.config.ts eslint.config.mjs --fix",
    "start:bot": "node dist/bot/index.js",
    "start:worker": "node dist/scheduler/worker.js",
    "start:news-worker": "node dist/scheduler/newsWorker.js",
    "start:api": "node dist/api/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart wordping-api wordping-bot wordping-worker wordping-news-worker --update-env",
    "pm2:stop": "pm2 stop wordping-api wordping-bot wordping-worker wordping-news-worker",
    "pm2:delete": "pm2 delete wordping-api wordping-bot wordping-worker wordping-news-worker",
    "pm2:logs": "pm2 logs",
    "backup:db": "node scripts/backup-db.mjs",
    "install:backup-cron": "bash scripts/install-backup-cron.sh",
    "restore:db": "node scripts/restore-db.mjs",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "build:web": "npm --prefix web run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^4.5.4",
    "node-cron": "^4.2.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/node": "^25.1.0",
    "@types/supertest": "^2.0.16",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "prisma": "^6.19.2",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^2.1.9"
  }
}
