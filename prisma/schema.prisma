// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DirectionMode {
  MIXED
  EN_TO_RU
  RU_TO_EN
}

enum CardDirection {
  EN_TO_RU
  RU_TO_EN
}

enum ReviewResult {
  CORRECT
  INCORRECT
  SKIPPED
}

enum SessionState {
  IDLE
  ADDING_WORD_WAIT_EN
  ADDING_WORD_CONFIRM_TRANSLATION
  ADDING_WORD_WAIT_RU_MANUAL
  WAITING_ANSWER
  WAITING_GRADE
  SETTINGS_WAIT_INTERVAL
  SETTINGS_WAIT_GOAL
  QUIZ_ACTIVE
}

enum NewsExampleTier {
  CACHE
  NEWSDATA
  GDELT
  GUARDIAN
  AI
}

enum NewsResolveJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum NewsProvider {
  NEWSDATA
  GDELT
  GUARDIAN
}

enum QuizRunStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum QuizQuestionMode {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_GAP
}

enum QuizAnswerOutcome {
  CORRECT
  WRONG
  SKIPPED
}

model User {
  id                     BigInt        @id
  tgUsername             String?       @db.VarChar(64)
  tgFirstName            String?       @db.VarChar(128)
  tgLastName             String?       @db.VarChar(128)
  tgDisplayName          String?       @db.VarChar(191)
  lastSeenAt             DateTime?
  createdAt              DateTime      @default(now())
  timezone               String?       @db.VarChar(64)
  directionMode          DirectionMode @default(MIXED)
  notificationsEnabled   Boolean       @default(true)
  // Quiet hours window (start == end => 24/7)
  quietHoursStartMinutes Int           @default(480) // 08:00
  quietHoursEndMinutes   Int           @default(1380) // 23:00

  // Notification controls
  maxNotificationsPerDay      Int       @default(20)
  notificationIntervalMinutes Int       @default(30)
  notificationsSentToday      Int       @default(0)
  notificationsDate           DateTime?
  lastNotificationAt          DateTime?

  streakCount       Int       @default(0)
  lastStreakDate    DateTime?
  doneTodayCount    Int       @default(0)
  correctTodayCount Int       @default(0)
  lastDoneDate      DateTime?

  // Referrals
  referredById        BigInt?
  referralQualifiedAt DateTime?
  referredBy          User?     @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]    @relation("UserReferrals")

  words                  Word[]
  reviews                Review[]
  dailyUsages            UserDailyUsage[]
  quizDailyUsages        QuizDailyUsage[]
  quizRuns               QuizRun[]
  session                UserSession?
  language               String           @default("ru")
  newsDigestLastOpenedAt DateTime?
  reviewFlowHintShownAt  DateTime?
  reviewFlowHintShownCount Int            @default(0)

  @@index([referredById])
  @@index([referredById, referralQualifiedAt])
  @@index([tgUsername])
  @@index([lastSeenAt])
}

model Word {
  id                      Int              @id @default(autoincrement())
  userId                  BigInt
  wordEn                  String           @db.VarChar(256)
  translationRu           String           @db.VarChar(256)
  exampleSentences        Json?            @db.JsonB
  sentenceIndex           Int              @default(0)
  newsExampleText         String?          @db.VarChar(2048)
  newsExampleTier         NewsExampleTier?
  newsExampleSourceUrl    String?          @db.VarChar(1024)
  newsExampleSourceTitle  String?          @db.VarChar(512)
  newsExamplePreparedAt   DateTime?
  newsExampleMatchedWord  String?          @db.VarChar(256)
  newsExampleNeedsRefresh Boolean          @default(false)
  createdAt               DateTime         @default(now())
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews                 Review[]
  newsResolveJob          NewsResolveJob?

  @@unique([userId, wordEn])
  @@index([userId])
  @@index([newsExamplePreparedAt])
}

model Review {
  id              Int            @id @default(autoincrement())
  userId          BigInt
  wordId          Int
  direction       CardDirection
  initialAutoReviewPending Boolean @default(false)
  hardStreak      Int            @default(0)
  lastReviewAt    DateTime?
  nextReviewAt    DateTime?
  stage           Int            @default(0)
  intervalMinutes Int            @default(0)
  lastDirection   CardDirection?
  lastAnswerText  String?
  lastResult      ReviewResult?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word            Word           @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, direction])
  @@index([userId, nextReviewAt])
  @@index([userId, initialAutoReviewPending, nextReviewAt])
  @@index([userId, direction, nextReviewAt])
  @@index([wordId])
}

model UserSession {
  userId       BigInt         @id
  state        SessionState   @default(IDLE)
  reviewId     Int?
  wordId       Int?
  direction    CardDirection?
  sentAt       DateTime?
  reminderStep Int            @default(0)
  answerText   String?
  payload      Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state])
}

model UserDailyUsage {
  id                 Int      @id @default(autoincrement())
  userId             BigInt
  dayStart           DateTime
  autoTranslateCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayStart])
  @@index([dayStart])
}

model QuizDailyUsage {
  id           Int      @id @default(autoincrement())
  userId       BigInt
  dayStart     DateTime
  startedCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayStart])
  @@index([dayStart])
}

model QuizRun {
  id              Int           @id @default(autoincrement())
  userId          BigInt
  status          QuizRunStatus @default(ACTIVE)
  totalQuestions  Int
  currentIndex    Int           @default(0)
  correctCount    Int           @default(0)
  wrongCount      Int           @default(0)
  skippedCount    Int           @default(0)
  startedAt       DateTime      @default(now())
  finishedAt      DateTime?
  durationSeconds Int?
  lastActivityAt  DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           QuizRunItem[]

  @@index([userId, status])
  @@index([startedAt])
  @@index([userId, startedAt])
}

model QuizRunItem {
  id                 Int               @id @default(autoincrement())
  runId              Int
  questionIndex      Int
  wordId             Int
  direction          CardDirection
  mode               QuizQuestionMode
  promptText         String            @db.VarChar(1024)
  options            Json?             @db.JsonB
  correctAnswer      String            @db.VarChar(256)
  correctOptionIndex Int?
  selectedAnswer     String?           @db.VarChar(256)
  selectedOptionIndex Int?
  outcome            QuizAnswerOutcome?
  answerTimeMs       Int?
  questionSentAt     DateTime?
  answeredAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  run                QuizRun           @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, questionIndex])
  @@index([runId, outcome])
  @@index([wordId])
}

model NewsCache {
  id          Int       @id @default(autoincrement())
  source      String    @db.VarChar(128)
  title       String    @db.VarChar(512)
  url         String    @unique @db.VarChar(1024)
  snippet     String    @db.VarChar(2048)
  bodyText    String?   @db.Text
  language    String?   @db.VarChar(16)
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
  expiresAt   DateTime?
  contentHash String    @unique @db.VarChar(64)

  @@index([publishedAt])
  @@index([expiresAt])
  @@index([language, publishedAt])
}

model NewsResolveJob {
  id          Int                  @id @default(autoincrement())
  wordId      Int                  @unique
  status      NewsResolveJobStatus @default(PENDING)
  attempts    Int                  @default(0)
  lastError   String?              @db.VarChar(512)
  scheduledAt DateTime             @default(now())
  lockedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  word        Word                 @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
}

model NewsProviderState {
  provider       NewsProvider @id
  dayStartUtc    DateTime
  requestsToday  Int          @default(0)
  lastRequestAt  DateTime?
  cooldownUntil  DateTime?
  lastStatusCode Int?
  lastError      String?      @db.VarChar(512)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([cooldownUntil])
  @@index([dayStartUtc])
}
